  "grammar_notes": [
    {
      "title": "Talking About the Past ('yakagadzikwa')",
      "content": "The verb 'yakagadzikwa' expresses a completed past action. Shona has two main ways to talk about the past: 1) For actions that happened earlier today or very recently, combine the short subject prefix ('nda-' = I, 'wa-' = you, 'a-' = he/she, 'ta-' = we, 'va-' = they) directly with the verb stem (e.g., 'ndamuka' = 'I woke up today', 'wabudirira' = 'you have succeeded'). 2) For events that happened yesterday or further in the past, insert '-ka-' after the subject prefix (e.g., 'takatenga' = 'we bought', 'vakaenda' = 'they went', 'akadanidzira' = 'he shouted').",
      "rule": "Recent Today Past: [nda- / wa- / ta- / va-] + verb | Earlier Past: [ndaka- / waka- / taka- / vaka-] + verb"
    },
    {
      "title": "Actions Happening Right Now: The '-ri ku-' Progressive",
      "content": "To describe an action that is happening right now ('I am doing', 'it is raining', 'they are walking'), Shona uses the helper verb '-ri' ('am/is/are') followed by 'ku-' ('to') and the action verb. For people, the forms are 'ndiri ku-' (I am), 'uri ku-' (you are), 'ari ku-' (he/she is), 'tiri ku-' (we are), and 'vari ku-' (they are). In fast speech or writing, the two words are sometimes joined together (e.g., 'ndiri kuenda' or 'ndirikuenda').",
      "rule": "[Subject + -ri] + ku-[verb] -> Ndiri kuverenga (I am reading) | Vari kufamba (They are walking) | Mvura iri kunaya (It is raining)"
    },
    {
      "title": "Present Tense & Everyday Actions ('kunovhara')",
      "content": "The verb 'kunovhara' uses the present marker '-no-'. In Shona, inserting '-no-' between the subject prefix and the verb stem expresses general truths, everyday habits, or states of mind like 'wanting', 'thinking', and 'knowing'. For example: 'ndinoda' ('I want/like'), 'unofunga' ('you think'), 'vanoti' ('they say'), and 'vanorima' ('they farm').",
      "rule": "[ndi- (I) / u- (you) / a- (he/she) / ti- (we) / va- (they)] + -no- + verb -> Ndinoda (I want), Vanogara (They live)"
    }
  ],
  "cultural_notes": [
    {
      "title": "Bustling Open-Air Markets ('Musika') & Neighbourhood Shops",
      "content": "Open-air markets ('pamusika') are vibrant community hubs across Zimbabwean towns and suburbs. Vendors sit beneath colourful umbrellas ('amburera') selling fresh fruits ('michero') like pineapples ('chinanasi'), bananas, tomatoes, and potatoes alongside clothing and household goods. For quick daily essentials close to home, residents also visit neighbourhood grocery stores ('zvitoro') and small corner tuckshops ('matakishopu').",
      "rule": null
    }
  ],
